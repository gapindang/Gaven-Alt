# GAVEN — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.
#
# How to get these values:
# 1. Go to https://supabase.com/dashboard
# 2. Select your GAVEN project
# 3. Go to Project Settings → Data API
# 4. Copy "Project URL" and "Publishable API key"
# ============================================================

# Supabase Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable / Anon Key (safe to expose client-side — protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
